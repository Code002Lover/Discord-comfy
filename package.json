{
  "name": "comfy",
  "version": "2.4.2",
  "description": "Stay comfy while talking to your friends",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "nodemon -e scss -x \"sass ./app.scss \"~/.config/vesktop/themes/comfy_dev.css\" --no-source-map\"",
    "build": "sass ./app.scss ./betterdiscord/main.css --no-source-map --style expanded",
    "lint": "prettier **/*.scss --check",
    "lint:fix": "prettier **/*.scss --write"
  },
  "author": "Nyria",
  "license": "WTFPL",
  "devDependencies": {
    "nodemon": "~3.1.14",
    "prettier": "~3.10.0",
    "sass": "~1.108.2"
  },
  "packageManager": "pnpm@12.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
